# CineHunt AI - file mau, KHONG co secret
# Copy sang ai/.env. Mac dinh ke thua DB_... tu backend/.env khi co.
# Path nay tinh tu thu muc ai/ khi chay uvicorn/python trong ai/.
BACKEND_ENV_PATH=../backend/.env
HOST=127.0.0.1
PORT=8000

# Neu khong dung backend/.env, tu khai bao DB_HOST/DB_PORT/
# DB_USERNAME/DB_PASSWORD/DB_DATABASE trong ai/.env RIENG TREN MAY.
# KHONG de DB_PASSWORD= rong neu muon ke thua gia tri tu backend/.env.
DB_CONNECTOR=pyodbc
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

MODEL_DIR=model
MODEL_FILE=recommender.joblib
MODEL_VERSION=v7-hybrid
WEIGHT_SVD=0.6
WEIGHT_CONTENT=0.3
WEIGHT_POPULARITY=0.1
SVD_COMPONENTS=50
TOP_N_CACHE=30
POSITIVE_BOOKING_STATUSES=PAID,ISSUED
AUTO_TRAIN_ON_START=false

# Bat buoc dat token rieng trong ai/.env khi can goi POST /train hoac /reload.
# De rong = tu choi thao tac quan tri (an toan hon).
RECOMMENDATION_ADMIN_TOKEN=
