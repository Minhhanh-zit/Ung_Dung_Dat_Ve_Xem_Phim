# CineHunt Backend - FILE MAU, KHONG DAT SECRET THAT O DAY
# Copy sang backend/.env va nhap gia tri tren MAY CUA BAN.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true

# SQL Server (port Docker mapping tuy may; may thu nghiem truoc dung 14332)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=
DB_DATABASE=CineHuntDB
# DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# KHONG tu dong migration tren DB chua duoc sao luu
DB_MIGRATIONS_RUN=false

# Bat buoc tao secret KHAC NHAU cho tung bien, tren may:
# openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI, chatbot. API keys la tuy chon; de trong neu chua su dung.
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8000
RECOMMENDATION_TIMEOUT_MS=5000
GEMINI_API_KEY=
# GEMINI_MODEL=
GROQ_API_KEY=
# GROQ_MODEL=

# Khong bat payment demo khi su dung du lieu that
ALLOW_DEMO_PAYMENT=false
