# Copy as .env.compose.local and fill with TEST-only credentials; never commit real values.
# Required TEST DB should ALREADY exist, have the CineHunt API-compatible schema,
# and be accessible from a Docker container via host.docker.internal:14332.
DB_HOST_PORT=14332
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=CineHunt_Test
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080
BACKEND_BIND=127.0.0.1
