# Copy to ~/.config/cinehunt/.env.staging on the Ubuntu VM.
# This file is local-only. Never commit real values.
# STAGING_DB_HOST is the Mac's Tailscale IPv4 address.
# STAGING_DB_PORT is the Mac socat proxy port, not the SQL container port.

STAGING_DB_HOST=100.64.0.10
STAGING_DB_PORT=14333

# This must be the isolated TEST database, never CineHuntDB.
DB_DATABASE=CineHunt_Test
DB_USERNAME=cinehunt_staging_app
DB_PASSWORD=REPLACE_WITH_THE_GENERATED_STAGING_LOGIN_PASSWORD

# Generate three different random values with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_REFRESH_SECRET
OTP_HASH_SECRET=REPLACE_WITH_RANDOM_OTP_SECRET

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
