{
  "uid": "cinehunt-local",
  "title": "CineHunt - Local Docker Containers",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Container CPU (100% = one CPU core)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "cinehunt-prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}, "targets": [{"refId": "A", "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\",image!=\"\"}[2m]))", "legendFormat": "{{name}}"}]},
    {"id": 2, "title": "Container memory working set", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "cinehunt-prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"refId": "A", "expr": "max by (name) (container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\",image!=\"\"})", "legendFormat": "{{name}}"}]},
    {"id": 3, "title": "Container network receive / transmit", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "cinehunt-prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum by (name) (rate(container_network_receive_bytes_total{job=\"cadvisor\",name!=\"\",interface!=\"lo\"}[2m]))", "legendFormat": "RX {{name}}"}, {"refId": "B", "expr": "sum by (name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",name!=\"\",interface!=\"lo\"}[2m]))", "legendFormat": "TX {{name}}"}]},
    {"id": 4, "title": "Prometheus scrape targets (1 = UP, 0 = DOWN)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "cinehunt-prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}, "targets": [{"refId": "A", "expr": "up", "legendFormat": "{{job}} / {{instance}}"}]}
  ]
}
