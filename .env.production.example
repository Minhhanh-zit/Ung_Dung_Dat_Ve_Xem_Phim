# Copy this file to .env.production and fill in real values.
# Never commit .env.production or any real secret.

# SQL Server
MSSQL_SA_PASSWORD=ChangeMe_StrongPassword_123!
DB_USERNAME=sa
DB_PASSWORD=ChangeMe_StrongPassword_123!
DB_DATABASE=CineHunt

# Backend
JWT_SECRET=change-this-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-refresh-secret
CORS_ORIGINS=https://your-domain.example,http://localhost:8080
ALLOW_DEMO_PAYMENT=false
DB_MIGRATIONS_RUN=false

# Optional bind addresses
SQLSERVER_BIND=127.0.0.1
BACKEND_BIND=127.0.0.1
WEB_BIND=0.0.0.0
